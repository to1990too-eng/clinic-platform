# --- Postgres ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
CLINIC_DB_URL=postgresql+asyncpg://clinic:clinic@localhost:5432/clinic
HUB_DB_URL=postgresql+asyncpg://clinic:clinic@localhost:5432/clinic_hub

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Clinic API ---
JWT_SECRET=super-secret-jwt-key-change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
INTERNAL_SHARED_SECRET=super-secret-internal-key

# --- Webhook Hub ---
STRIPE_HMAC_SECRET=stripe-secret
CALENDAR_HMAC_SECRET=calendar-secret
SMS_HMAC_SECRET=sms-secret
CLINIC_INTERNAL_URL=http://127.0.0.1:8000/internal/events
HUB_MAX_ATTEMPTS=5
HUB_STUCK_TTL_SECONDS=300
HUB_LATE_WINDOW_HOURS=24